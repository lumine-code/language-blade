{
  "name": "Blade",
  "scopeName": "text.html.php.blade",
  "type": "tree-sitter",
  "parser": "tree-sitter-blade",
  // `<<<BLADE` in a PHP heredoc resolves through here: language-php's heredoc
  // injection returns the tag text verbatim as the language string.
  "injectionNames": ["blade"],
  // `getGrammarPathScore` splits both the path and each file type on `[/.]` and
  // scores a suffix match as the file type's length, so `blade.php` scores 9
  // against language-php's `php` at 3 and takes a `.blade.php` outright.
  // `blade` covers the projects that drop the second extension.
  "fileTypes": ["blade.php", "blade"],
  "comments": {
    "start": "{{-- ",
    "end": " --}}",
    "block": ["{{--", "--}}"]
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:EmranMR/tree-sitter-blade#v0.12.3",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "blade.wasm",
    // tree-sitter-blade inlines tree-sitter-html's grammar and takes over its
    // tree, so the HTML half of each query is a port of language-html's and
    // stays in its own file — keep that file diffable against its origin.
    // Blade's own rules load second, so they can build on what the HTML rules
    // already applied.
    "highlightsQuery": ["blade-html-highlights.scm", "blade-highlights.scm"],
    "foldsQuery": ["blade-html-folds.scm", "blade-folds.scm"],
    "indentsQuery": ["blade-html-indents.scm", "blade-indents.scm"]
    // No tags query: a view declares no symbols a tag file would index.
  }
}
