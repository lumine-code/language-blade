{
  "name": "language-blade",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "lib/main",
  "files": [
    "grammars",
    "lib",
    "settings",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "description": "Blade language support.",
  "keywords": [
    "laravel",
    "livewire",
    "alpinejs",
    "templating",
    "tree-sitter"
  ],
  "repository": "https://github.com/lumine-code/language-blade",
  "bugs": {
    "url": "https://github.com/lumine-code/language-blade/issues"
  },
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "language-php",
    "symbol-tree-sitter",
    "language-shellscript"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
